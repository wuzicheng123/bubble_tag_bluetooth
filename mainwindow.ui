   <string notr="true">
/* ========== 全局样式 ========== */
* {
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, &quot;Roboto&quot;;
    font-size: 11pt;
    outline: none; /* 移除焦点虚线框 */
}

QMainWindow {
    background-color: #f5f7fa;
}

QWidget#centralWidget {
    background-color: transparent;
}

/* ========== 按钮样式 ========== */
QPushButton {
    background-color: #0078d4;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    transition: background 0.2s;
}

QPushButton:hover {
    background-color: #106ebe;
}

QPushButton:pressed {
    background-color: #005a9e;
}

QPushButton:disabled {
    background-color: #c7c7c7;
    color: #6e6e6e;
}

/* ========== 分组框样式 ========== */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e1e5eb;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    top: 0px;
    padding: 0 12px;
    background-color: #ffffff;
    color: #0078d4;
}

/* ========== 列表控件 ========== */
QListWidget, QTreeWidget {
    background-color: #ffffff;
    border: 1px solid #d4d8dd;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item, QTreeWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #f0f0f0;
    border-radius: 4px;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #e1f0fa;
    color: #0078d4;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #f5f5f5;
}

/* ========== 表格视图 ========== */
QTableView {
    border: 1px solid #d4d8dd;
    border-radius: 8px;
    background-color: white;
    alternate-background-color: #fafbfc;
    selection-background-color: #0078d4;
}

QTableView::item {
    padding: 6px;
    border-bottom: 1px solid #eef2f5;
}

QTableView::item:selected {
    background-color: #0078d4;
    color: white;
}

QHeaderView::section {
    background-color: #f2f4f8;
    padding: 8px;
    border: none;
    border-right: 1px solid #e1e5eb;
    border-bottom: 1px solid #e1e5eb;
    font-weight: bold;
    color: #2c3e50;
}

/* ========== 菜单样式 ========== */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e1e5eb;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e1f0fa;
    color: #0078d4;
}

QMenu {
    background-color: white;
    border: 1px solid #d4d8dd;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #e1e5eb;
    margin: 4px 8px;
}

/* ========== 标签样式 ========== */
QLabel {
    color: #2c3e50;
}

QLabel[class=&quot;titleLabel&quot;] {
    font-size: 14pt;
    font-weight: bold;
    color: #0078d4;
}

/* ========== 自定义绘图控件背景 ========== */
QWidget#plotWidget {
    background-color: #ffffff;
    border: 1px solid #e1e5eb;
    border-radius: 10px;
}
